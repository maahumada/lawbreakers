{
  "name": "lawbreakers",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:pages": "LAWBREAKERS_BASE=/lawbreakers/ npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b",
    "smoke": "node scripts/smoke-worker.mjs",
    "screenshots": "node scripts/screenshot-mission.mjs",
    "rack-smoke": "node scripts/rack-smoke.mjs",
    "engage-smoke": "node scripts/engage-smoke.mjs",
    "missions-smoke": "node scripts/missions-smoke.mjs",
    "campaign-smoke": "node scripts/campaign-smoke.mjs",
    "pages-preview": "node scripts/pages-preview.mjs",
    "coi-smoke": "node scripts/coi-smoke.mjs",
    "dafny-check": "node scripts/dafny-check.mjs",
    "proof-smoke": "node scripts/proof-smoke.mjs",
    "juice-smoke": "node scripts/juice-smoke.mjs",
    "a11y-smoke": "node scripts/a11y-smoke.mjs",
    "cost-search": "node scripts/cost-search.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "z3-solver": "^5.3.2",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "coi-serviceworker": "0.1.7",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright": "^1.57.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
